# ---- Скопируйте в .env и заполните реальными значениями ----

# Postgres
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgres://pmo:change-me-strong-password@postgres:5432/pmo

# Секрет для подписи сессионных токенов (JWT) и cookie
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=https://pmo.qslaide.beget.tech

# MCP-коннектор для Коворка: ключи доступа через запятую (заголовок X-Api-Key).
# На pmo.gigaenterprise.ai ключ создаётся автоматически при деплое.
MCP_API_KEYS=generate-with-openssl-rand-hex-24
