# ---- Скопируйте в .env и заполните реальными значениями ----

# Postgres
POSTGRES_PASSWORD=change-me-strong-password
DATABASE_URL=postgres://pmo:change-me-strong-password@postgres:5432/pmo

# Better Auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=https://pmo.qslaide.beget.tech

# SMTP для писем (подтверждение почты / сброс пароля)
# Вариант 1: Яндекс.Почта для домена (бесплатно) — smtp.yandex.ru, порт 465
# Вариант 2: любой транзакционный сервис (Unisender и т.п.)
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=noreply@ваш-домен
SMTP_PASSWORD=пароль-приложения-от-почты
SMTP_FROM="GigaCowork Enterprise <noreply@ваш-домен>"
